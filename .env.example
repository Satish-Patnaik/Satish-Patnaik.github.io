# Copy this file to .env.local and fill in real values before running `pnpm run dev` / `pnpm run build`.
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
# DO NOT commit .env.local to git.

# --- Supabase (only needed if/when real auth + database are wired up) ---
# Currently the project's Auth.tsx and AdminDashboard.tsx are local stubs and do not call Supabase,
# so these are optional today. Set them when we replace the stubs with real auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI chat backend (only needed if AIChat is upgraded from rule-based to an LLM) ---
# Currently AIChat.tsx is a scripted bot with no API call. Leave blank for now.
VITE_AI_CHAT_API_URL=
VITE_AI_CHAT_API_KEY=

# --- Optional: contact form / service request backend ---
# If we later wire ServiceRequestForm.tsx to a backend (e.g., Formspree, EmailJS, Supabase edge function),
# put the endpoint here.
VITE_CONTACT_FORM_ENDPOINT=
